{
  "kind": "collectionType",
  "collectionName": "types",
  "info": {
    "singularName": "type",
    "pluralName": "types",
    "displayName": "Type"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string"
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::producto.producto",
      "mappedBy": "type"
    },
    "categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::category.category",
      "mappedBy": "type"
    },
    "slug": {
      "type": "uid"
    },
    "personal_brands": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::peronal-brand.peronal-brand",
      "mappedBy": "types"
    },
    "reference_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    }
  }
}
